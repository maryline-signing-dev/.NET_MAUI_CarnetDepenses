<CollectionView.ItemTemplate>
    <DataTemplate>
        <Grid ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="10"
              Padding="8,6">

            <!-- Libellé + date -->
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="{Binding Libelle}"
                       FontAttributes="Bold"
                       FontSize="16"/>
                <Label Text="{Binding Date, StringFormat='{0:dd/MM/yyyy}'}"
                       FontSize="12"
                       TextColor="Gray"/>
            </VerticalStackLayout>

            <!-- Montant -->
            <Label Grid.Column="1"
                   Text="{Binding Montant, StringFormat='{0:N0} F'}"
                   FontAttributes="Bold"
                   FontSize="16"
                   VerticalOptions="Center"
                   TextColor="#2E7D32"/>

            <!-- Bouton supprimer -->
            <Button Grid.Column="2"
                    Text="✕"
                    Command="{Binding SupprimerCommand,
                        Source={RelativeSource
                        AncestorType={x:Type vm:DepensesViewModel}}}"
                    CommandParameter="{Binding .}"
                    WidthRequest="40"
                    HeightRequest="40"
                    BackgroundColor="Transparent"
                    TextColor="Red"/>
        </Grid>
    </DataTemplate>
</CollectionView.ItemTemplate>